# App Environment
NODE_ENV=development
APP_ENV=development
PORT=3000

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Financial OS"
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financial_os
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/financial_os

# Redis / Workers
REDIS_URL=redis://localhost:6379/0

# AI Configuration (CIEL & Providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Financial OS"
